--cpu=Cortex-M4.fp
"bootloader\startup_stm32g431xx.o"
"bootloader\main.o"
"bootloader\gpio.o"
"bootloader\usart.o"
"bootloader\stm32g4xx_it.o"
"bootloader\stm32g4xx_hal_msp.o"
"bootloader\stm32g4xx_hal_pwr_ex.o"
"bootloader\stm32g4xx_hal_uart.o"
"bootloader\stm32g4xx_hal_uart_ex.o"
"bootloader\stm32g4xx_hal.o"
"bootloader\stm32g4xx_hal_rcc.o"
"bootloader\stm32g4xx_hal_rcc_ex.o"
"bootloader\stm32g4xx_hal_flash.o"
"bootloader\stm32g4xx_hal_flash_ex.o"
"bootloader\stm32g4xx_hal_flash_ramfunc.o"
"bootloader\stm32g4xx_hal_gpio.o"
"bootloader\stm32g4xx_hal_exti.o"
"bootloader\stm32g4xx_hal_dma.o"
"bootloader\stm32g4xx_hal_dma_ex.o"
"bootloader\stm32g4xx_hal_pwr.o"
