#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
串口 IAP 上位机脚本 (兼容优化版)
针对逐帧ACK的Bootloader优化，提升传输速度
"""

import serial
import serial.tools.list_ports
import sys
import time
import struct

# ============ 可调参数 ============
BAUD = 115200
BLOCK = 256          # 增大到1KB（如果Bootloader支持）
# BLOCK = 512          # 如果1KB不行，改512
MAX_RETRY = 3
ACK, NACK = 0x06, 0x15
CMD_HS, CMD_ERASE, CMD_DATA, CMD_END, CMD_JUMP = 1, 2, 3, 4, 5
# =================================


def crc16(data: bytes, init: int = 0xFFFF) -> int:
    """CRC16-CCITT 校验"""
    crc = init
    for b in data:
        crc ^= b << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if (crc & 0x8000) else (crc << 1) & 0xFFFF
    return crc


def build_frame(cmd: int, data: bytes = b"") -> bytes:
    """构建IAP帧"""
    frame = bytes([0xAA, 0x55, cmd,
                   len(data) & 0xFF, (len(data) >> 8) & 0xFF]) + data
    c = crc16(frame)
    return frame + bytes([c & 0xFF, (c >> 8) & 0xFF])


def send_with_retry(ser, frame, timeout=0.5) -> bool:
    """发送并等待ACK（带重试）"""
    for attempt in range(MAX_RETRY):
        ser.write(frame)
        # 使用更长的超时给MCU处理时间
        resp = ser.read(1)
        if resp == bytes([ACK]):
            return True
        elif resp == bytes([NACK]):
            # NACK立即重试
            if attempt < MAX_RETRY - 1:
                time.sleep(0.02)
                continue
        # 超时或其他
        time.sleep(0.05)
    return False


def pick_port() -> str:
    """交互式选择串口"""
    ports = list(serial.tools.list_ports.comports())
    if not ports:
        print("未检测到任何串口")
        sys.exit(1)
    print("\n可用串口:")
    for i, p in enumerate(ports):
        print(f"  [{i}] {p.device}  -  {p.description}")
    while True:
        try:
            idx = int(input("请输入序号选择串口: ").strip())
            if 0 <= idx < len(ports):
                return ports[idx].device
        except (ValueError, IndexError):
            pass
        print("序号无效，请重新输入")


def main():
    # 解析命令行
    if len(sys.argv) >= 2:
        path = sys.argv[1]
    else:
        path = input("请输入 bin 文件绝对路径: ").strip().strip('"')
        if not path:
            print("未输入路径，退出")
            sys.exit(1)
    
    # 读取文件
    try:
        with open(path, "rb") as f:
            bin_data = f.read()
    except OSError as e:
        print(f"无法打开文件: {e}")
        sys.exit(1)
    
    print(f"\n文件: {path}")
    print(f"文件大小: {len(bin_data)} 字节 ({len(bin_data)/1024:.2f} KB)")
    print(f"数据块大小: {BLOCK} 字节")
    print(f"预计帧数: {(len(bin_data) + BLOCK - 1) // BLOCK} 帧")

    # 选择串口
    port = sys.argv[2] if len(sys.argv) > 2 else pick_port()
    print(f"使用串口: {port}")

    # 打开串口（增大缓冲区）
    ser = serial.Serial(port, BAUD, timeout=1, write_timeout=1)
    ser.set_buffer_size(rx_size=4096, tx_size=4096)
    ser.reset_input_buffer()
    ser.reset_output_buffer()

    try:
        print("\n请确保目标板已进入 Bootloader 模式...")
        input("按回车键开始烧录 (Ctrl+C 取消): ")
        
        ser.reset_input_buffer()
        
        # 1. 握手
        print("\n[1/5] 握手...", end="", flush=True)
        if not send_with_retry(ser, build_frame(CMD_HS), timeout=1.0):
            print(" 失败 ❌")
            time.sleep(3)
            return
        print(" 成功 ✅")

        # 2. 擦除
        print("[2/5] 擦除 Flash...", end="", flush=True)
        if not send_with_retry(ser, build_frame(CMD_ERASE), timeout=3.0):
            print(" 失败 ❌")
            time.sleep(3)
            return
        print(" 完成 ✅")

        # 3. 发送数据（逐帧ACK，但优化了缓存和计算）
        print("[3/5] 发送数据...")
        total = len(bin_data)
        total_crc = 0xFFFF
        start_time = time.time()
        
        # 预计算所有帧的CRC，避免传输中重复计算
        frames = []
        for i in range(0, total, BLOCK):
            chunk = bin_data[i:i + BLOCK]
            total_crc = crc16(chunk, total_crc)
            frames.append(build_frame(CMD_DATA, chunk))
        
        print(f"已预生成 {len(frames)} 个数据帧")
        
        # 发送所有帧
        for idx, frame in enumerate(frames):
            if not send_with_retry(ser, frame):
                done = idx * BLOCK
                print(f"\n数据帧失败 @ 0x{done:X}，重试次数用尽")
                time.sleep(3)
                return
            
            # 更新进度（每5帧更新一次，减少打印开销）
            if idx % 5 == 0 or idx == len(frames) - 1:
                done = min((idx + 1) * BLOCK, total)
                progress = done * 100 // total
                elapsed = time.time() - start_time
                if elapsed > 0 and done > 0:
                    speed = done / elapsed / 1024
                    print(f"\r进度: {done}/{total} ({progress}%) 速度: {speed:.1f} KB/s", end="")
                else:
                    print(f"\r进度: {done}/{total} ({progress}%)", end="")
        
        elapsed = time.time() - start_time
        avg_speed = total / elapsed / 1024 if elapsed > 0 else 0
        print(f"\n数据发送完成 ✅ (耗时: {elapsed:.1f}s, 平均速度: {avg_speed:.1f} KB/s)")

        # 4. 结束校验
        print("[4/5] 整包校验...", end="", flush=True)
        end_data = len(bin_data).to_bytes(4, "little") + total_crc.to_bytes(2, "little")
        if not send_with_retry(ser, build_frame(CMD_END, end_data), timeout=2.0):
            print(" 失败 ❌")
            time.sleep(3)
            return
        print(" 通过 ✅")

        # 5. 跳转
        print("[5/5] 跳转 App...", end="", flush=True)
        send_with_retry(ser, build_frame(CMD_JUMP), timeout=0.5)
        print(" 完成 ✅")

        print("\n🎉 烧录成功！")
        time.sleep(2)

    except KeyboardInterrupt:
        print("\n\n用户取消操作")
    except serial.SerialException as e:
        print(f"\n串口错误: {e}")
    finally:
        ser.close()


if __name__ == "__main__":
    main()
